{
  "name": "innovative-teaching-prompt-studio",
  "version": "3.15.0",
  "description": "Innovative Teaching Prompt Studio (創意教學 Prompt Studio) — single-file React app for SEN teachers to generate structured AI prompts (Gemini / Claude / Lovable / v0)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:icons && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "check:icons": "node scripts/check-icons.mjs"
  },
  "dependencies": {
    "docx": "^7.8.2",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "terser": "^5.48.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^0.13.5",
    "vitest": "^1.6.0"
  }
}
